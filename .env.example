# Porta do servidor
PORT=3000

# Token obrigatório para as rotas /admin/* (geração de chaves)
ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio

# Diretório de onde os arquivos são servidos (subpasta = id)
FILES_DIR=./files

# Extensões que podem ser entregues
ALLOWED_EXTENSIONS=.lua,.manifest

# Onde as chaves são persistidas
DATA_DIR=./data
