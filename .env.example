# ------------------------------------------------------------------
# Servidor
# ------------------------------------------------------------------
PORT=3000
# Interface de escuta. Mantenha 127.0.0.1 para acesso local.
# (No Docker Compose isso e sobrescrito para 0.0.0.0 dentro do container;
#  a porta publicada fica restrita a 127.0.0.1 do host por padrao.)
HOST=127.0.0.1

# Token das rotas /admin/* (gere um aleatorio longo; o instalador faz isso).
ADMIN_TOKEN=

# ------------------------------------------------------------------
# Origem dos arquivos
# ------------------------------------------------------------------
# Repositorio GitHub COM UMA BRANCH POR APPID que voce tem permissao
# para distribuir. Formato: owner/repo (ex.: minha-empresa/meus-manifests)
GITHUB_REPOSITORY=

# Opcional: token GitHub (aumenta o limite de requisicoes).
# NUNCA coloque um token de escopo amplo aqui.
GITHUB_TOKEN=

# API do GitHub (mude apenas para GitHub Enterprise ou testes)
GITHUB_API_URL=https://api.github.com

# Template da branch para um AppID. {appid} e substituido pelo AppID.
BRANCH_TEMPLATE={appid}

# ------------------------------------------------------------------
# Cache persistente (compartilhado por API e bot)
# ------------------------------------------------------------------
DATA_DIR=./data
CACHE_DIR=
# Segundos antes de checar o commit da branch novamente
CACHE_TTL_SECONDS=300
# Idade maxima de um cache velho servido quando o GitHub cai
CACHE_STALE_MAX_SECONDS=604800

# ------------------------------------------------------------------
# Limites
# ------------------------------------------------------------------
REQUEST_TIMEOUT_MS=15000
MAX_FILE_BYTES=52428800
MAX_ZIP_BYTES=209715200
DEFAULT_RATE_PER_MINUTE=60

# ------------------------------------------------------------------
# Discord (opcional - instalar com API + Discord)
# ------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Chave gerada pelo instalador; nao edite manualmente sem motivo.
DISCORD_API_KEY=
DISCORD_API_URL=http://localhost:3000
DISCORD_COOLDOWN_SECONDS=30
DISCORD_MAX_FILE_MB=8
DISCORD_TIMEOUT_MS=30000
