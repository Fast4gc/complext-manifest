# ==================================================================
# Manifest Gate — exemplo de configuracao
# Copie para .env e preencha.  O instalador (. /install.sh) preserva
# um .env ja existente e so preenche o que faltar.
#   cp .env.example .env && chmod 600 .env
# ==================================================================

# ------------------------------------------------------------------
# Servidor
# ------------------------------------------------------------------
PORT=3000
# Interface de escuta. Mantenha 127.0.0.1 para acesso local.
# (No Docker Compose isso e sobrescrito para 0.0.0.0 dentro do container;
#  a porta publicada fica restrita a 127.0.0.1 do host por padrao.)
HOST=127.0.0.1

# Token das rotas /admin/* (gere um aleatorio longo; o instalador faz isso).
ADMIN_TOKEN=

# ------------------------------------------------------------------
# Fontes de manifests
# ------------------------------------------------------------------
# Ordem de prioridade com fallback. A PRIMEIRA que responder com sucesso
# vence; as demais so entram se a anterior falhar.
#   source=<id> numa consulta escolhe UMA fonte e DESLIGA o fallback:
#   se ela falhar, o erro dela e o erro da resposta.
#
# IDs aceitos:
#   github       repositorio do operador (GITHUB_REPOSITORY abaixo)
#   manifesthub  steamtoolsapp/ManifestHub (publico, sem credencial propria)
SOURCE_PRIORITY=github,manifesthub

# Repositorio GitHub COM UMA BRANCH POR APPID que voce tem permissao
# para distribuir. Formato: owner/repo (ex.: minha-empresa/meus-manifests)
# Vazio = esta fonte e pulada na prioridade (e responde
# repositorio_nao_configurado se pedida com source=github).
GITHUB_REPOSITORY=

# Opcional: token GitHub (aumenta o limite de requisicoes).
# Sem token a API do GitHub da 60 req/h por IP; com token, 5000/h.
# Um token invalido vira o erro LOUD github_auth — nunca some em silencio.
# NUNCA coloque um token de escopo amplo aqui.
GITHUB_TOKEN=

# API do GitHub (mude apenas para GitHub Enterprise ou testes)
GITHUB_API_URL=https://api.github.com

# Base dos links brutos (raw). Usada so para APONTAR arquivos de
# configuracao que este servico nao baixa; o cliente busca direto.
GITHUB_RAW_URL=https://raw.githubusercontent.com

# Template da branch para um AppID. {appid} e substituido.
BRANCH_TEMPLATE={appid}

# ---- Fonte publica ManifestHub -----------------------------------
# Mesmo mecanismo (branch por AppID) apontando para o repo publico.
# Nunca listamos as ~62 mil branches do repositorio: consultamos a branch
# do AppID pedido.
MANIFESTHUB_REPOSITORY=steamtoolsapp/ManifestHub
MANIFESTHUB_BRANCH_TEMPLATE={appid}
MANIFESTHUB_ENABLED=true
# Desligue a fonte do operador sem apagar a configuracao dela:
GITHUB_SOURCE_ENABLED=true

# ------------------------------------------------------------------
# Busca por nome (GET /search e /busca no bot)
# ------------------------------------------------------------------
# Fonte: busca publica da loja da Steam. Nao exige token nem login, e nao
# inventa AppID: devolve so o que a loja respondeu.
SEARCH_ENABLED=true
STEAM_STORE_API_URL=https://store.steampowered.com/api
SEARCH_TIMEOUT_MS=10000
# Resultados por resposta (a loja ignora `limit`; o corte e feito aqui).
SEARCH_LIMIT=10
# Bucket de rate limit da busca, separado do da chave da API, para uma
# rajada de buscas nao estourar a cota da loja.
SEARCH_RATE_PER_MINUTE=20
# Cache em memoria do resultado por termo.
SEARCH_TTL_SECONDS=600

# ------------------------------------------------------------------
# Links temporarios de download (opcional)
# ------------------------------------------------------------------
# Um link e um token HMAC assinado com fonte, AppID e expiracao: nao ha
# estado no servidor, adulteracao nao abre e data vencida nao abre.
# So funciona se PUBLIC_BASE_URL existir — a API escuta em 127.0.0.1, entao
# sem URL publica ninguem de fora alcanca /links/<token>.
PUBLIC_BASE_URL=
# Segredo da assinatura. Se vazio, cai para ADMIN_TOKEN.
LINK_SECRET=
LINK_TTL_SECONDS=900
LINK_TTL_MAX_SECONDS=86400

# ------------------------------------------------------------------
# Cache persistente (compartilhado por API e bot)
# ------------------------------------------------------------------
DATA_DIR=./data
# Vazio = <DATA_DIR>/cache. A entrada e <cache>/<fonte>/<appid>/, ou seja,
# a mesma entrada so vale para a fonte que a produziu.
CACHE_DIR=
# Segundos antes de checar o commit da branch novamente
CACHE_TTL_SECONDS=300
# Idade maxima de um cache velho servido quando a fonte cai
CACHE_STALE_MAX_SECONDS=604800
# Teto total do cache em bytes (5 GiB por padrao). Ao estourar, as entradas
# mais antigas sao removidas primeiro. 0 = sem teto.
CACHE_MAX_BYTES=5368709120

# ------------------------------------------------------------------
# Limites
# ------------------------------------------------------------------
REQUEST_TIMEOUT_MS=15000
# Tamanho maximo de um UNICO .manifest (50 MiB)
MAX_FILE_BYTES=52428800
# Tamanho maximo da soma dos manifests num ZIP (200 MiB)
MAX_ZIP_BYTES=209715200
# Requisicoes por minuto por chave da API
DEFAULT_RATE_PER_MINUTE=60

# ------------------------------------------------------------------
# Discord (opcional - instalar com API + Discord)
# ------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Chave gerada pelo instalador; nao edite manualmente sem motivo.
DISCORD_API_KEY=
# O bot roda dentro da rede do Compose: use o NOME DO SERVICO, nao localhost.
# (O instalador corrige sozinho um valor localhost antigo.)
DISCORD_API_URL=http://api:3000
DISCORD_COOLDOWN_SECONDS=30
DISCORD_MAX_FILE_MB=8
DISCORD_TIMEOUT_MS=30000
